# BFF stay-client-bff — variables serveur (jamais exposées au navigateur).
PORT=4000
# Origine(s) autorisée(s) pour CORS — le front. (défaut : http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
# Frontière PMS (Stay-api) — source unique de vérité
PMS_BASE_URL=http://localhost:5231/api/v1
# Clé de service pour POST /reservations/{id}/confirm (comparée à SERVICE_KEY côté PMS)
SERVICE_KEY=change-me-service-key
# Secret de session (cookie opaque / custody des jetons en Redis)
SESSION_SECRET=change-me-session-secret
# Magasin d'état éphémère
REDIS_URL=redis://localhost:6379
# NB : les clés Stripe SECRÈTES restent côté PMS. Le BFF n'en détient aucune.
