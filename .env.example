# BFF stay-client-bff — variables serveur (jamais exposées au navigateur).
PORT=4000
# Origine autorisée pour CORS — le front CLIENTE sur :3001 (:3000 = back-office Stay).
# ⚠️ Avec cookie de session + credentials, une origine erronée casse la session silencieusement.
CORS_ORIGIN=http://localhost:3001
# Frontière PMS (Stay-api) — source unique de vérité
PMS_BASE_URL=http://localhost:5231/api/v1
# Clé de service pour POST /reservations/{id}/confirm (comparée à SERVICE_KEY côté PMS)
SERVICE_KEY=change-me-service-key
# Secret de session — signature HMAC du cookie opaque (custody des jetons en Redis, story 2.1).
# ⚠️ OBLIGATOIRE, minimum 32 caractères : le BFF refuse de démarrer sinon (fail-fast).
# La valeur ci-dessous est volontairement TROP COURTE : un `cp .env.example .env` doit échouer
# bruyamment plutôt que de faire tourner le BFF avec un secret publié dans le dépôt (n'importe qui
# pourrait alors forger un cookie de session). Générez la vôtre, par environnement :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=REMPLACER-32-caracteres-minimum
# Nom du cookie de session (défaut : stay_sid).
SESSION_COOKIE_NAME=stay_sid
# Attribut Secure du cookie (défaut : true ; http://localhost est un contexte sécurisé).
# Ne passer à false que derrière un proxy exotique en environnement non-TLS.
SESSION_COOKIE_SECURE=true
# Magasin d'état éphémère (unique magasin d'état du BFF — AR-6)
REDIS_URL=redis://localhost:6379
# Niveau de log pino (trace|debug|info|warn|error). Défaut : info.
LOG_LEVEL=info
# NB : les clés Stripe SECRÈTES restent côté PMS. Le BFF n'en détient aucune.

# --- Résilience du client PMS (valeurs par défaut si non renseignées) ---
# Timeout par tentative (ms)
PMS_TIMEOUT_MS=8000
# Nombre de tentatives supplémentaires (retries backoff, réseau/5xx uniquement)
PMS_MAX_RETRIES=2
# Délai de base du backoff exponentiel (ms)
PMS_RETRY_BASE_DELAY_MS=150
# Circuit breaker (opossum)
PMS_BREAKER_ERROR_THRESHOLD=50
PMS_BREAKER_RESET_MS=10000
PMS_BREAKER_VOLUME=5

# --- Recherche multi-hôtels (repli fan-out D1 — story 1.6) ---
# Plafond d'hôtels candidats sondés par recherche (borne le fan-out).
SEARCH_FANOUT_MAX_HOTELS=25
# Parallélisme maximal des appels de disponibilité par hôtel.
SEARCH_FANOUT_CONCURRENCY=6
# TTL (secondes) du cache Redis des résultats de recherche (borne 30–60 s recommandée).
SEARCH_CACHE_TTL_SECONDS=45

# --- Recherche « à proximité » (FR-2 — story 1.7 ; candidats via PMS /Hotels/nearby) ---
# Rayon par défaut (km) quand l'URL n'en fournit pas (défaut PMS = 10).
SEARCH_NEARBY_DEFAULT_RADIUS_KM=10
# Rayon maximal (km) accepté (le param URL est borné à cette valeur).
SEARCH_NEARBY_MAX_RADIUS_KM=100
# Plafond de candidats demandés au PMS /Hotels/nearby (MaxResults). Défaut = plafond de fan-out.
SEARCH_NEARBY_MAX_RESULTS=25

# --- Page hôtel publique (module catalog — story 1.9) ---
# TTL (secondes) du cache Redis du détail hôtel + galerie (entier, jamais 0). Défaut 60.
CATALOG_CACHE_TTL_SECONDS=60
# Plafond de chambres sondées pour composer la galerie (aligné sur ce que le front rend). Défaut 5.
CATALOG_GALLERY_MAX_ROOMS=5
# Parallélisme max des appels d'images de chambre (borne la charge PMS et le TTFB SSR). Défaut 4.
CATALOG_GALLERY_CONCURRENCY=4
# Durée max d'un séjour (nuits) ; au-delà, les dates sont ignorées (repli prix/nuit). Défaut 90.
CATALOG_MAX_STAY_NIGHTS=90

# --- Tunnel de réservation (module booking — story 2.2) ---
# Durée max d'un séjour (nuits) pour un DEVIS ; au-delà, la requête est refusée en 400 (un
# récapitulatif ne peut pas retomber sur un affichage prix/nuit). Défaut 90.
# Pas de TTL ici : le devis délègue à `catalog`, déjà caché — deux caches = deux vérités de prix.
BOOKING_MAX_STAY_NIGHTS=90

# --- Création de réservation & Hold de checkout (module booking — story 2.4, FR-9/FR-14) ---
# Durée du Hold de checkout (secondes) : temps pendant lequel la chambre est tenue sans paiement.
# ⚠️ Le PMS ne sait pas « tenir » une chambre — c'est la réservation `Pending` qui l'immobilise.
# Ce réglage est donc le délai au bout duquel le BALAYEUR annule une `Pending` restée impayée.
# Trop long = inventaire gelé ; trop court = voyageur éjecté en plein paiement. Bornes 300–3600.
BOOKING_HOLD_TTL_SECONDS=900
# Sursis (secondes) pendant lequel l'ENREGISTREMENT de hold survit à son échéance.
# ⚠️ Vital : le balayeur a besoin du `sid` du propriétaire APRÈS expiration (l'annulation PMS exige
# son JWT). Un sursis nul rendrait toute libération automatique impossible → chambre gelée à vie.
BOOKING_HOLD_GRACE_SECONDS=3600
# TTL (ms) du verrou qui sérialise les créations concurrentes sur une CHAMBRE (toutes dates
# confondues : un verrou par (chambre, dates) ne sérialiserait pas deux séjours qui SE CHEVAUCHENT,
# ex. 09-01→09-03 et 09-02→09-04, qui sont pourtant le cas de double-booking à empêcher).
# ⚠️ Doit couvrir le budget de la SECTION CRITIQUE ENTIÈRE, pas d'un seul appel : sous verrou, le
# pré-contrôle compose la fiche chambre (4 appels PMS, chacun retryé ≈ 25 s au pire) AVANT de poster
# la création. Un verrou trop court expire PENDANT la création et le PMS — dépourvu d'atomicité
# (dépendance D3) — pourrait accepter deux réservations chevauchantes.
# Bornes 25 000–300 000. Le BFF REFUSE DE DÉMARRER si la valeur passe sous le budget d'un appel PMS
# complet (PMS_TIMEOUT_MS × (PMS_MAX_RETRIES + 1) + backoff) : un verrou décoratif est pire qu'un
# verrou absent, car il donne l'illusion de la sérialisation.
BOOKING_STAY_LOCK_MS=90000
# Attente max (ms) du perdant du verrou avant d'abandonner en 503 (jamais un faux « indisponible »).
BOOKING_LOCK_WAIT_MS=5000
# Intervalle (ms) de scrutation du verrou. DOIT rester strictement inférieur à BOOKING_LOCK_WAIT_MS
# (refus au démarrage sinon : une seule lecture serait faite, budget dépassé d'un ordre de grandeur).
BOOKING_LOCK_POLL_MS=100
# Période (ms) du balayeur de holds échus. NE PEUT PAS dépasser la durée du hold (refus au
# démarrage) : l'inventaire resterait gelé au-delà de la promesse faite au voyageur.
BOOKING_SWEEPER_INTERVAL_MS=60000
# Nombre max de holds traités par passe (borne la charge PMS d'une passe).
BOOKING_SWEEPER_BATCH=50
# Passes infructueuses après lesquelles un hold est abandonné, avec un log `error` explicite
# (la chambre reste alors immobilisée jusqu'au filet 48 h du PMS — dépendance D3).
BOOKING_SWEEPER_MAX_ATTEMPTS=5
# Report (ms) d'un hold dont la libération a échoué, avant nouvelle tentative.
# ⚠️ NE PEUT PAS dépasser BOOKING_HOLD_TTL_SECONDS + BOOKING_HOLD_GRACE_SECONDS (refus au
# démarrage) : au-delà, l'enregistrement a expiré quand le balayeur revient, l'entrée passe pour un
# « index orphelin » et disparaît SANS annulation ni log d'erreur — chambre gelée en silence.
BOOKING_SWEEPER_RETRY_MS=60000
# Active la planification du balayeur. Coupé automatiquement sous NODE_ENV=test (les suites e2e
# bootent AppModule et un balayeur en fond émettrait des appels PMS non interceptés par nock).
# Toute forme de « non » coupe (false | 0 | no | off | n, casse et espaces indifférents) : ce
# composant ANNULE de vraies réservations, une valeur mal orthographiée ne doit pas l'activer.
BOOKING_SWEEPER_ENABLED=true
# Délai (ms) avant qu'une INTENTION DE CRÉATION non résolue soit réconciliée par le balayeur.
# À quoi ça sert : l'intention est écrite AVANT le POST au PMS. Si la réponse se perd (timeout,
# coupure réseau, 5xx), le BFF ignore si la `Pending` existe ; l'intention survit et le balayeur va
# la chercher dans /roomreservations/my-reservations pour l'annuler s'il la trouve.
# ⚠️ Doit rester CONFORTABLEMENT supérieur au budget d'un appel PMS complet (refus au démarrage
# sinon) : trop court, le balayeur annulerait une création encore EN VOL, sous les yeux du
# voyageur ; trop long, une `Pending` fantôme gèle une vraie chambre d'autant plus longtemps.
# Bornes 30 000–600 000.
BOOKING_INTENT_RECONCILE_MS=90000

# Durée de vie (secondes) de la LANGUE DE COMMUNICATION mémorisée pour une Réservation
# (story 2.5, FR-10). Le PMS ne porte aucun champ de langue sur la réservation (dépendance D10) :
# le choix du voyageur vit donc sous sa propre clé Redis, en attendant que la story 3.2 le lise à
# la confirmation.
# ⚠️ VOLONTAIREMENT DÉCOUPLÉE DU HOLD. La langue suit la *Réservation*, pas la tenue de chambre :
# la lier au hold la faisait disparaître dès que le balayeur libérait la chambre — alors que
# l'écran affirme « enregistré avec votre réservation ». Le repère qui fait sens est le plafond
# dur d'une `Pending` non payée : 48 h (dépendance D3, PRD §9-D3).
# Plancher aligné sur BOOKING_HOLD_TTL_SECONDS + BOOKING_HOLD_GRACE_SECONDS : plus court la ferait
# expirer AVANT le hold, ce qui reproduirait exactement le défaut corrigé. Plafond 604 800 (7 j).
BOOKING_COMM_LOCALE_TTL_SECONDS=172800

# --- Limitation de débit (anti-abus — story 2.4, FR-9/NFR-7) ---
# Portée VOLONTAIREMENT bornée à POST /booking/reservations et POST /auth/guest : les deux
# écritures qui laissent une trace durable dans le PMS (une `Pending` gèle une vraie chambre, un
# provisioning crée un vrai `Customer`). Le durcissement transverse relève de la story 6.1.
# ⚠️ Deux incohérences sont REFUSÉES AU BOOT (fail-fast, comme les réglages du module booking) :
#   - THROTTLE_IDENTITY_LIMIT > THROTTLE_IP_LIMIT : le compteur d'identité ne se déclencherait
#     jamais pour un client donné, l'IP bloquant en premier ;
#   - THROTTLE_BLOCK_MS > THROTTLE_WINDOW_MS : la sanction survivrait à la fenêtre qui l'a
#     déclenchée, sans qu'aucun compteur ne la justifie plus.
# Fenêtre de comptage (ms), commune aux deux compteurs.
THROTTLE_WINDOW_MS=60000
# Requêtes autorisées par adresse IP et par fenêtre.
THROTTLE_IP_LIMIT=10
# Requêtes autorisées par compte (ou par email au Checkout invité) et par fenêtre — plus strict :
# sans lui, un botnet contournerait la limite par IP.
# NB : sur POST /booking/reservations, ce seuil est DOUBLÉ (plafonné à THROTTLE_IP_LIMIT) pour
# absorber les rejeux idempotents — double-clic, F5, retour arrière — que le limiteur compte avant
# que le service ne les reconnaisse. POST /auth/guest garde le seuil nu.
THROTTLE_IDENTITY_LIMIT=5
# Durée de blocage (ms) une fois la limite franchie. À son expiration, le compteur repart de ZÉRO
# (le compteur Redis expire avec le blocage) : la sanction dure exactement ce qui est configuré.
THROTTLE_BLOCK_MS=60000
# `trust proxy` d'Express — commande la valeur de req.ip, sur laquelle repose la limite par IP.
# ⚠️ Réglage de SÉCURITÉ, sans valeur universellement sûre :
#   - laissé à false derrière un reverse-proxy, toutes les requêtes partagent l'IP du proxy
#     (un seul seau pour tout le monde, le premier abuseur bloque tous les voyageurs) ;
#   - mis à true sans proxy réel, n'importe qui forge X-Forwarded-For et CONTOURNE la limite.
# Valeurs : false | true | <nombre de sauts de proxy de confiance> | <liste d'IP/CIDR>
#           (les mots-clés Express loopback | linklocal | uniquelocal sont acceptés).
# ⚠️ Toute autre valeur (« 1.5 », « -1 », « oui »…) ARRÊTE LE BOOT avec un message nommant
# TRUST_PROXY. Et une variable NON RENSEIGNÉE sous NODE_ENV=production produit un log `error` :
# en production, ce silence signifie « toute la plateforme dans un seul seau de limitation ».
# En déploiement derrière un reverse-proxy (docker-compose/k8s), renseignez le nombre de sauts.
TRUST_PROXY=false
